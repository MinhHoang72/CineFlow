<%@ page pageEncoding="UTF-8" %>
<%-- Ma giam gia + nut sua bap nuoc cho don dang giu ghe (dat ve online va ban tai quay).
     Can co: booking, extrasAction (URL POST: /booking hoac /staff/counter), fnbUrl (trang chon bap nuoc),
     voucherOptions (List<VoucherOptionDTO>: voucher chon duoc cho don nay). --%>
<div class="mb-3">
    <a href="${fnbUrl}" class="btn btn-outline-secondary btn-sm w-100">
        🍿 ${empty booking.fnbLines ? 'Thêm bắp nước' : 'Sửa bắp nước'}
    </a>
</div>

<div class="border rounded p-3 mb-3">
    <h6 class="mb-2">🎟️ Mã giảm giá <small class="text-muted fw-normal">(chỉ áp dụng cho tiền vé)</small></h6>
    <c:choose>
        <c:when test="${not empty booking.voucherCode}">
            <form method="post" action="${extrasAction}" class="d-flex justify-content-between align-items-center">
                <input type="hidden" name="action" value="remove-voucher">
                <input type="hidden" name="bookingId" value="${booking.id}">
                <span>Đang dùng <strong><c:out value="${booking.voucherCode}"/></strong>:
                    giảm <fmt:formatNumber value="${booking.discountAmount}" pattern="#,##0"/> đ</span>
                <button type="submit" class="btn btn-outline-secondary btn-sm">Bỏ mã</button>
            </form>
        </c:when>
        <c:otherwise>
            <form method="post" action="${extrasAction}" class="d-flex gap-2">
                <input type="hidden" name="action" value="apply-voucher">
                <input type="hidden" name="bookingId" value="${booking.id}">
                <input type="text" class="form-control form-control-sm text-uppercase" name="voucherCode"
                       maxlength="50" placeholder="Nhập mã, ví dụ WELCOME10" required>
                <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">Áp dụng</button>
            </form>
        </c:otherwise>
    </c:choose>

    <c:if test="${not empty voucherOptions}">
        <div class="small text-muted mt-3 mb-1">
            ${empty booking.voucherCode ? 'Hoặc chọn mã có sẵn cho đơn này:' : 'Đổi sang mã khác:'}
        </div>
        <div class="voucher-options">
            <c:forEach var="v" items="${voucherOptions}">
                <div class="voucher-option d-flex align-items-center gap-2 ${v.usable ? '' : 'is-locked'}">
                    <div class="flex-grow-1 min-w-0">
                        <div>
                            <strong><c:out value="${v.code}"/></strong>
                            <span class="badge bg-danger-subtle text-danger-emphasis">
                                <c:choose>
                                    <c:when test="${v.percent}">
                                        Giảm <fmt:formatNumber value="${v.value}" pattern="#,##0.##"/>%<c:if test="${not empty v.maximumDiscount}">,
                                        tối đa <fmt:formatNumber value="${v.maximumDiscount}" pattern="#,##0"/> đ</c:if>
                                    </c:when>
                                    <c:otherwise>Giảm <fmt:formatNumber value="${v.value}" pattern="#,##0"/> đ</c:otherwise>
                                </c:choose>
                            </span>
                        </div>
                        <div class="small text-muted text-truncate"><c:out value="${v.name}"/></div>
                        <div class="small text-muted">
                            <c:if test="${v.minimumOrderValue > 0}">
                                Tiền vé từ <fmt:formatNumber value="${v.minimumOrderValue}" pattern="#,##0"/> đ ·
                            </c:if>
                            HSD <fmt:formatDate value="${v.endDate}" pattern="dd/MM/yyyy"/>
                        </div>
                    </div>
                    <c:choose>
                        <c:when test="${v.usable}">
                            <form method="post" action="${extrasAction}" class="text-end">
                                <input type="hidden" name="action" value="apply-voucher">
                                <input type="hidden" name="bookingId" value="${booking.id}">
                                <input type="hidden" name="voucherCode" value="${v.code}">
                                <div class="small text-success text-nowrap mb-1">
                                    − <fmt:formatNumber value="${v.discount}" pattern="#,##0"/> đ
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">Dùng</button>
                            </form>
                        </c:when>
                        <c:otherwise>
                            <div class="small text-muted text-end" style="max-width: 120px">
                                Cần thêm <fmt:formatNumber value="${v.missingAmount}" pattern="#,##0"/> đ tiền vé
                            </div>
                        </c:otherwise>
                    </c:choose>
                </div>
            </c:forEach>
        </div>
    </c:if>
</div>
