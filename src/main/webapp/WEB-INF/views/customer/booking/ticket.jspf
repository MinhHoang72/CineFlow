<%@ page pageEncoding="UTF-8" %>
<%-- Ve dien tu cua don: moi ghe mot ma QR de soat ve, danh sach bap nuoc de nhan mon, bang chi tiet tien.
     Can co: booking, tickets, ticketQrs (TicketCode -> anh QR). --%>
<div class="eticket" data-bs-theme="light">
    <div class="text-muted small">CINEFLOW · <c:out value="${booking.showtime.centreName}"/></div>
    <div class="fs-4 fw-bold"><c:out value="${booking.showtime.movieTitle}"/></div>
    <div class="mb-3">
        <fmt:formatDate value="${booking.showtime.startTime}" pattern="HH:mm - dd/MM/yyyy"/> ·
        <c:out value="${booking.showtime.hallName}"/> (${booking.showtime.hallType}) ·
        <strong>${tickets.size()} ghế</strong> ·
        Đơn <code><c:out value="${booking.code}"/></code>
    </div>

    <div class="row g-3 mb-1">
        <c:forEach var="t" items="${tickets}">
            <div class="col-6 col-md-4 col-xl-3 text-center seat-ticket">
                <div class="fw-bold">Ghế ${t.seatLabel} <span class="small fw-normal text-muted">${t.seatType}</span></div>
                <img src="${ticketQrs[t.code]}" alt="QR vé ghế ${t.seatLabel}" class="qr">
                <div><code><c:out value="${t.code}"/></code></div>
                <c:if test="${t.status == 'USED'}"><div class="small fw-bold text-muted">Đã soát vé</div></c:if>
            </div>
        </c:forEach>
    </div>
    <div class="small text-muted mb-3">Mỗi ghế có một mã riêng, đưa mã của từng ghế cho nhân viên soát vé.</div>

    <c:if test="${not empty booking.fnbLines}">
        <div class="fw-bold">Bắp nước</div>
        <ul class="mb-1">
            <c:forEach var="line" items="${booking.fnbLines}">
                <li><c:out value="${line.name}"/> × ${line.quantity}</li>
            </c:forEach>
        </ul>
        <div class="small text-muted mb-3">Đưa danh sách này cho nhân viên quầy bắp nước để nhận món.</div>
    </c:if>

    <table class="table table-sm mb-0">
        <thead>
        <tr><th>Hạng mục</th><th>Chi tiết</th><th class="text-end">Thành tiền</th></tr>
        </thead>
        <tbody>
        <c:forEach var="seat" items="${booking.seats}">
            <tr>
                <td>Ghế <strong>${seat.label}</strong></td>
                <td>${seat.type}</td>
                <td class="text-end"><fmt:formatNumber value="${seat.price}" pattern="#,##0"/> đ</td>
            </tr>
        </c:forEach>
        <c:forEach var="line" items="${booking.fnbLines}">
            <tr>
                <td><c:out value="${line.name}"/></td>
                <td>${line.combo ? 'Combo' : 'Bắp nước'} × ${line.quantity}</td>
                <td class="text-end"><fmt:formatNumber value="${line.lineTotal}" pattern="#,##0"/> đ</td>
            </tr>
        </c:forEach>
        <c:if test="${booking.discountAmount > 0}">
            <tr>
                <td>Giảm giá</td>
                <td><c:out value="${booking.voucherCode}"/> (trên tiền vé)</td>
                <td class="text-end text-success">− <fmt:formatNumber value="${booking.discountAmount}" pattern="#,##0"/> đ</td>
            </tr>
        </c:if>
        </tbody>
        <tfoot>
        <tr>
            <th colspan="2">Tổng cộng</th>
            <th class="text-end"><fmt:formatNumber value="${booking.totalAmount}" pattern="#,##0"/> đ</th>
        </tr>
        </tfoot>
    </table>
</div>
