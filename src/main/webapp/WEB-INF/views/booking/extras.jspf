<%@ page pageEncoding="UTF-8" %>
<%-- Chon bap nuoc + ma giam gia cho don dang giu ghe (dat ve online va ban tai quay).
     Can co: booking, fnbMenu (List<FnbMenuItemDTO>), extrasAction (URL POST: /booking hoac /staff/counter). --%>
<c:set var="fnbQty" value="${booking.fnbQuantities}"/>

<div class="border rounded p-3 mb-3">
    <h6 class="mb-2">🍿 Bắp nước</h6>
    <c:choose>
        <c:when test="${empty fnbMenu}">
            <div class="text-muted small">Rạp hiện chưa có món nào đang bán.</div>
        </c:when>
        <c:otherwise>
            <form method="post" action="${extrasAction}">
                <input type="hidden" name="action" value="save-fnb">
                <input type="hidden" name="bookingId" value="${booking.id}">
                <table class="table table-sm align-middle mb-2">
                    <tbody>
                    <c:forEach var="m" items="${fnbMenu}">
                        <tr>
                            <td>
                                <strong><c:out value="${m.name}"/></strong>
                                <c:if test="${m.combo}"><span class="badge bg-info text-dark">Combo</span></c:if>
                                <c:if test="${not empty m.description}">
                                    <div class="small text-muted"><c:out value="${m.description}"/></div>
                                </c:if>
                            </td>
                            <td class="text-end text-nowrap"><fmt:formatNumber value="${m.price}" pattern="#,##0"/> đ</td>
                            <td style="width: 90px">
                                <input type="number" class="form-control form-control-sm" name="qty_${m.key}"
                                       min="0" max="${m.maxQuantity}" value="${empty fnbQty[m.key] ? 0 : fnbQty[m.key]}"
                                       aria-label="Số lượng ${m.name}">
                            </td>
                        </tr>
                    </c:forEach>
                    </tbody>
                </table>
                <button type="submit" class="btn btn-outline-primary btn-sm w-100">Cập nhật bắp nước</button>
            </form>
        </c:otherwise>
    </c:choose>
</div>

<div class="border rounded p-3 mb-3">
    <h6 class="mb-2">🎟️ Mã giảm giá <small class="text-muted fw-normal">(chỉ áp dụng cho tiền vé)</small></h6>
    <c:choose>
        <c:when test="${not empty booking.voucherCode}">
            <form method="post" action="${extrasAction}" class="d-flex justify-content-between align-items-center">
                <input type="hidden" name="action" value="remove-voucher">
                <input type="hidden" name="bookingId" value="${booking.id}">
                <span>Đang dùng <strong><c:out value="${booking.voucherCode}"/></strong>:
                    giảm <fmt:formatNumber value="${booking.discountAmount}" pattern="#,##0"/> đ</span>
                <button type="submit" class="btn btn-outline-secondary btn-sm">Bỏ mã</button>
            </form>
        </c:when>
        <c:otherwise>
            <form method="post" action="${extrasAction}" class="d-flex gap-2">
                <input type="hidden" name="action" value="apply-voucher">
                <input type="hidden" name="bookingId" value="${booking.id}">
                <input type="text" class="form-control form-control-sm text-uppercase" name="voucherCode"
                       maxlength="50" placeholder="Nhập mã, ví dụ WELCOME10" required>
                <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">Áp dụng</button>
            </form>
        </c:otherwise>
    </c:choose>
</div>
