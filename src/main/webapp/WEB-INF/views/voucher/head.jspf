<%@ page pageEncoding="UTF-8" %>
<%@ page import="model.User" %>
<%!
    static String esc(Object value) {
        if (value == null) {
            return "";
        }
        return value.toString().replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("\"", "&quot;").replace("'", "&#39;");
    }

    static String pager(String ctx, String base, int page, int totalPages) {
        if (totalPages <= 1) {
            return "";
        }
        StringBuilder html = new StringBuilder("<nav class=\"vc-pages\">");
        html.append(page > 1 ? "<a href=\"" + ctx + base + (page - 1) + "\">&lsaquo;</a>" : "<span class=\"disabled\">&lsaquo;</span>");
        int last = 0;
        for (int i = 1; i <= totalPages; i++) {
            if (i == 1 || i == totalPages || Math.abs(i - page) <= 1) {
                if (last != 0 && i - last > 1) {
                    html.append("<span class=\"gap\">&hellip;</span>");
                }
                html.append(i == page ? "<span class=\"active\">" + i + "</span>" : "<a href=\"" + ctx + base + i + "\">" + i + "</a>");
                last = i;
            }
        }
        html.append(page < totalPages ? "<a href=\"" + ctx + base + (page + 1) + "\">&rsaquo;</a>" : "<span class=\"disabled\">&rsaquo;</span>");
        return html.append("</nav>").toString();
    }

    static String money(java.math.BigDecimal value) {
        if (value == null) {
            return "";
        }
        return new java.text.DecimalFormat("#,##0", new java.text.DecimalFormatSymbols(java.util.Locale.GERMANY)).format(value) + " đ";
    }
%>
<%
    String ctx = request.getContextPath();
    User currentUser = (User) session.getAttribute("user");
    boolean adminUser = currentUser != null && "ADMIN".equals(currentUser.getRole());
    boolean isAdminScope = Boolean.TRUE.equals(request.getAttribute("isAdminScope"));
    request.setAttribute("activeNav", "vouchers");
    String shellTitle = (String) request.getAttribute("pageTitle");
    String flashType = (String) request.getAttribute("flashType");
    String flashMessage = (String) request.getAttribute("flashMessage");
    String baseUrl = (String) request.getAttribute("baseUrl");
    if (baseUrl == null) {
        baseUrl = ctx + (adminUser ? "/admin/vouchers" : "/manager/vouchers");
    }
%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= esc(shellTitle) %> | CineFlow</title>
    <link rel="stylesheet" href="<%= ctx %>/css/common/reset.css">
    <link rel="stylesheet" href="<%= ctx %>/css/common/variables.css">
    <link rel="stylesheet" href="<%= ctx %>/css/common/buttons.css">
    <link rel="stylesheet" href="<%= ctx %>/css/common/badges.css">
    <link rel="stylesheet" href="<%= ctx %>/css/common/forms.css">
    <link rel="stylesheet" href="<%= ctx %>/css/common/tables.css">
    <link rel="stylesheet" href="<%= ctx %>/css/manager/shell.css">
    <link rel="stylesheet" href="<%= ctx %>/css/admin/dashboard.css">
    <style>
        .vc-flash { padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-weight: 600; }
        .vc-flash.success { background: #dcfce7; color: #166534; }
        .vc-flash.error { background: #fee2e2; color: #991b1b; }
        .vc-filter { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; padding: 14px; }
        .vc-filter label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 600; }
        .vc-pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 18px; flex-wrap: wrap; border-top: 1px solid rgba(148, 163, 184, .18); }
        .vc-pager .info { color: #94a3b8; font-size: 13px; }
        .vc-pages { display: flex; gap: 6px; align-items: center; }
        .vc-pages a, .vc-pages span { min-width: 34px; height: 34px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid rgba(148, 163, 184, .25); color: #cbd5e1; font-weight: 600; font-size: 14px; text-decoration: none; }
        .vc-pages a:hover { background: rgba(255, 42, 84, .15); border-color: #ff2a54; color: #fff; }
        .vc-pages .active { background: #ff2a54; border-color: #ff2a54; color: #fff; }
        .vc-pages .disabled { opacity: .35; }
        .vc-pages .gap { border: 0; min-width: 20px; padding: 0; }
        .cf-form-group label.cf-form-label, .cf-form-label { display: block; margin-bottom: 6px; color: #e2e8f0; font-weight: 600; font-size: 14px; }
        .cf-help { color: #94a3b8; font-size: 12px; margin-top: 4px; }
        .cf-form-group { margin-bottom: 16px; }
        .vc-form .cf-btn[type=submit] { margin-top: 6px; }
        .vc-error { color: #fca5a5; font-size: 13px; margin-top: 4px; font-weight: 600; }
        .vc-inline { display: inline; }
        .vc-lines { display: flex; flex-direction: column; gap: 8px; }
        .vc-line { display: flex; gap: 8px; align-items: center; }
        .vc-thumb { width: 48px; height: 48px; object-fit: cover; border-radius: 8px; display: inline-flex; vertical-align: middle; }
        .vc-noimg { align-items: center; justify-content: center; background: rgba(148, 163, 184, .15); font-size: 22px; }
        .vc-preview { max-width: 180px; max-height: 140px; border-radius: 10px; object-fit: cover; display: block; }
        .vc-form { max-width: 720px; padding: 18px; }
        .vc-scope-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 12px; }
        .vc-scope-global { background: rgba(99,102,241,.18); color: #a5b4fc; }
        .vc-scope-branch { background: rgba(16,185,129,.18); color: #6ee7b7; }
    </style>
</head>
<body>
<div class="cf-manager-shell">
    <% if (adminUser && isAdminScope) { %>
    <jsp:include page="/admin/sidebar.jsp" />
    <% } else { %>
    <jsp:include page="/manager/sidebar.jsp" />
    <% } %>
    <div class="cf-manager-main">
        <% if (adminUser && isAdminScope) { %>
        <jsp:include page="/admin/topbar.jsp" />
        <% } else { %>
        <jsp:include page="/manager/topbar.jsp" />
        <% } %>
        <main class="cf-content">
            <% if (flashMessage != null) { %>
                <div class="vc-flash <%= "success".equals(flashType) ? "success" : "error" %>"><%= esc(flashMessage) %></div>
            <% } %>
