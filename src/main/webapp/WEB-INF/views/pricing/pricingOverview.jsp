<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("pageTitle", "Giá vé cơ bản"); request.setAttribute("pageDescription", "Quản lý giá cơ bản và theo dõi lịch sử điều chỉnh tại chi nhánh."); request.setAttribute("activeTab", "base"); %>
<%@ include file="/WEB-INF/fragments/cinemaBegin.jspf" %>
<div class="st-pricing-grid">
<section class="st-panel"><div class="st-panel-heading"><div><h2>Giá cơ bản hiện tại</h2><p>Chi nhánh #${centreId}</p></div></div><div class="st-price-card"><c:choose><c:when test="${not empty currentPrice}"><span class="st-status st-status-COMPLETED">Đang áp dụng</span><strong class="st-price-value"><c:out value="${currentPrice.basePriceFormatted}" /></strong><p>Hiệu lực từ <c:out value="${currentPrice.effectiveFromFormatted}" /></p></c:when><c:otherwise><strong class="st-price-value">Chưa thiết lập</strong><p>Nhập giá cơ bản để cấu hình bảng giá cho chi nhánh.</p></c:otherwise></c:choose></div></section>
<section class="st-panel"><div class="st-panel-heading"><div><h2>Cập nhật giá cơ bản</h2><p>Giá mới có hiệu lực ngay sau khi lưu.</p></div></div>
<form class="st-create-form" action="${pageContext.request.contextPath}/pricing/update" method="post"><input type="hidden" name="centreId" value="${centreId}"><div class="st-field"><label for="base-price">Giá cơ bản mới (VNĐ) <span>*</span></label><input id="base-price" type="number" name="basePrice" min="0" step="1000" required placeholder="Ví dụ: 80000"></div><div class="st-form-footer"><p>Thay đổi cũ được giữ trong lịch sử giá.</p><button class="st-button st-button-primary" type="submit">Cập nhật giá</button></div></form></section>
</div>
<section class="st-panel"><div class="st-panel-heading"><div><h2>Lịch sử giá cơ bản <span class="st-count">${fn:length(history)}</span></h2><p>Các mức giá và thời gian áp dụng.</p></div></div>
<div class="st-table-scroll" tabindex="0" role="region" aria-label="Lịch sử giá cơ bản"><table class="st-table st-table-compact"><thead><tr><th scope="col">STT</th><th scope="col">Giá cơ bản</th><th scope="col">Hiệu lực từ</th><th scope="col">Hiệu lực đến</th><th scope="col">Người cập nhật</th></tr></thead><tbody><c:forEach var="p" items="${history}" varStatus="loop"><tr><td>${loop.count}</td><td><strong class="st-money"><c:out value="${p.basePriceFormatted}" /></strong></td><td><c:out value="${p.effectiveFromFormatted}" /></td><td><c:choose><c:when test="${empty p.effectiveTo}"><span class="st-status st-status-COMPLETED">Đang áp dụng</span></c:when><c:otherwise><c:out value="${p.effectiveToFormatted}" /></c:otherwise></c:choose></td><td><c:out value="${p.updatedBy}" default="—" /></td></tr></c:forEach></tbody></table></div>
<c:if test="${empty history}"><div class="st-empty"><h3>Chưa có lịch sử giá</h3><p>Các lần cập nhật giá sẽ xuất hiện tại đây.</p></div></c:if></section>
<%@ include file="/WEB-INF/fragments/cinemaEnd.jspf" %>
