<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("pageTitle", "Phụ thu ghế & phòng"); request.setAttribute("pageDescription", "Quản lý mức phụ thu theo loại ghế, loại phòng và theo dõi lịch sử thay đổi."); request.setAttribute("activeTab", "surcharge"); %>
<%@ include file="/WEB-INF/fragments/cinemaBegin.jspf" %>
<section class="st-panel"><div class="st-panel-heading"><div><h2>Phụ thu đang áp dụng <span class="st-count">${fn:length(currentRules)}</span></h2><p>Phân biệt phụ thu loại ghế và phụ thu loại phòng chiếu.</p></div></div>
<div class="st-table-scroll" tabindex="0" role="region" aria-label="Các phụ thu hiện tại"><table class="st-table st-table-compact"><thead><tr><th scope="col">Loại / Đối tượng</th><th scope="col">Tên phụ thu</th><th scope="col">Số tiền</th><th scope="col">Hiệu lực từ</th><th scope="col">Thao tác</th></tr></thead><tbody>
<c:forEach var="s" items="${currentRules}"><tr><td><span class="st-format">${s.surchargeType == 'HALL' ? 'Phòng chiếu' : 'Ghế'}</span><span class="st-hall-name"><c:out value="${s.targetValue}" /></span></td><td><strong class="st-movie"><c:out value="${s.surchargeName}" /></strong></td><td class="st-money"><c:out value="${s.amountFormatted}" /></td><td><c:out value="${s.effectiveFromFormatted}" /></td><td><div class="st-row-actions"><a class="st-link" href="${pageContext.request.contextPath}/pricing/seat-surcharges/edit?id=${s.surchargeId}">Sửa</a><form action="${pageContext.request.contextPath}/pricing/seat-surcharges/delete" method="post" data-confirm="Ngừng áp dụng phụ thu này?"><input type="hidden" name="id" value="${s.surchargeId}"><button class="st-link st-link-danger" type="submit">Ngừng áp dụng</button></form></div></td></tr></c:forEach>
</tbody></table></div><c:if test="${empty currentRules}"><div class="st-empty"><h3>Chưa có phụ thu đang áp dụng</h3><p>Các phụ thu loại ghế và loại phòng sẽ hiển thị tại đây.</p></div></c:if></section>
<section class="st-panel"><div class="st-panel-heading"><div><h2>Lịch sử phụ thu</h2><p>Theo dõi đối tượng, mức tiền và thời gian hiệu lực.</p></div></div>
<div class="st-table-scroll" tabindex="0" role="region" aria-label="Lịch sử phụ thu"><table class="st-table st-table-compact"><thead><tr><th scope="col">STT</th><th scope="col">Loại / Đối tượng</th><th scope="col">Tên phụ thu</th><th scope="col">Số tiền</th><th scope="col">Hiệu lực từ</th><th scope="col">Hiệu lực đến</th><th scope="col">Người cập nhật</th></tr></thead><tbody>
<c:forEach var="s" items="${history}" varStatus="loop"><tr><td>${loop.count}</td><td><span class="st-format">${s.surchargeType == 'HALL' ? 'Phòng chiếu' : 'Ghế'}</span> <c:out value="${s.targetValue}" /></td><td><c:out value="${s.surchargeName}" /></td><td class="st-money"><c:out value="${s.amountFormatted}" /></td><td><c:out value="${s.effectiveFromFormatted}" /></td><td><c:choose><c:when test="${empty s.effectiveTo}"><span class="st-status st-status-COMPLETED">Đang áp dụng</span></c:when><c:otherwise><c:out value="${s.effectiveToFormatted}" /></c:otherwise></c:choose></td><td><c:out value="${s.updatedBy}" default="—" /></td></tr></c:forEach>
</tbody></table></div><c:if test="${empty history}"><div class="st-empty"><h3>Chưa có lịch sử phụ thu</h3></div></c:if></section>
<%@ include file="/WEB-INF/fragments/cinemaEnd.jspf" %>
