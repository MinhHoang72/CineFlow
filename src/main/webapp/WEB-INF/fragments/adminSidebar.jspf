<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    String cfPath = request.getContextPath();

    // 1. Lấy URI và ServletPath gốc (hỗ trợ cả các trường hợp request được forward qua Servlet)
    String originalUri = (String) request.getAttribute("jakarta.servlet.forward.request_uri");
    if (originalUri == null || originalUri.isBlank()) {
        originalUri = request.getRequestURI();
    }

    String originalServletPath = (String) request.getAttribute("jakarta.servlet.forward.servlet_path");
    if (originalServletPath == null || originalServletPath.isBlank()) {
        originalServletPath = request.getServletPath();
    }

    String pathInfo = (String) request.getAttribute("jakarta.servlet.forward.path_info");
    if (pathInfo == null) {
        pathInfo = request.getPathInfo();
    }

    String fullReqPath = (originalServletPath != null ? originalServletPath : "") + (pathInfo != null ? pathInfo : "");
    if (fullReqPath.isEmpty()) {
        fullReqPath = originalUri;
    }

    String jspUri = request.getRequestURI();

    String activeNav = (String) request.getAttribute("activeNav");
    if (activeNav == null || activeNav.isBlank() || "report-hub".equals(activeNav)) {
        if (fullReqPath.contains("/admin/centres") || fullReqPath.contains("/admin/centre") || fullReqPath.contains("/halls") || fullReqPath.contains("/seats") || jspUri.contains("halls")) {
            activeNav = "centres";
        } else if (fullReqPath.contains("/admin/distribution")) {
            activeNav = "distribution";
        } else if (fullReqPath.contains("/admin/movies") || fullReqPath.contains("/admin/movie")) {
            activeNav = "movies";
        } else if (fullReqPath.contains("/admin/customers")) {
            activeNav = "customers";
        } else if (fullReqPath.contains("/admin/managers")) {
            activeNav = "managers";
        } else if (fullReqPath.contains("/admin/transfers/history") || fullReqPath.contains("/admin/staff-history") || jspUri.contains("history")) {
            activeNav = "staff-history";
        } else if (fullReqPath.contains("/admin/transfers") || jspUri.contains("transfers")) {
            activeNav = "transfers";
        } else if (fullReqPath.contains("/fnb") || jspUri.contains("fnb")) {
            activeNav = "fnb";
        } else if (fullReqPath.contains("/vouchers") || jspUri.contains("voucher")) {
            activeNav = "vouchers";
        } else if (fullReqPath.contains("/payments") || jspUri.contains("paymentMonitoring")) {
            activeNav = "payments";
        } else if (fullReqPath.contains("/report/operations") || fullReqPath.contains("/operations") || jspUri.contains("reportOperations") || fullReqPath.contains("/reports") || jspUri.contains("adminReport")) {
            activeNav = "report-operations";
        } else if (fullReqPath.contains("/report/sales") || fullReqPath.contains("/sales") || jspUri.contains("reportSales")) {
            activeNav = "report-sales";
        } else if (fullReqPath.contains("/account") || fullReqPath.contains("/profile") || jspUri.contains("userProfile") || jspUri.contains("profile")) {
            activeNav = "account";
        } else if (fullReqPath.contains("/dashboard") || fullReqPath.endsWith("/admin") || fullReqPath.contains("/report/chain") || jspUri.contains("adminDashboard")) {
            activeNav = "dashboard";
        } else {
            activeNav = "";
        }
    }
%>
<aside class="cf-sidebar" id="adminSidebar">
    <a class="cf-sidebar-brand" href="<%= cfPath %>/dashboard">Cine<span>Flow</span></a>

    <div class="cf-sidebar-section">TỔNG QUAN</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "dashboard".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/dashboard">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </span>Dashboard
        </a>
    </nav>

    <div class="cf-sidebar-section">HỆ THỐNG CỤM RẠP</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "centres".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/centres">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M3 7v14M21 7v14M6 7V3h12v4M9 11h2M13 11h2M9 15h2M13 15h2"/></svg>
            </span>Quản lý Cụm rạp
        </a>
    </nav>

    <div class="cf-sidebar-section">QUẢN LÝ PHIM</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "movies".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/movies">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>
            </span>Danh mục phim
        </a>
        <a class="<%= "distribution".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/distribution">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </span>Phân phối rạp chiếu
        </a>
    </nav>

    <div class="cf-sidebar-section">BẮP NƯỚC</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "fnb".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/fnb">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
            </span>Món &amp; Combo
        </a>
    </nav>

    <div class="cf-sidebar-section">KHUYẾN MÃI</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "vouchers".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/vouchers">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"></path><line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2 2"></line></svg>
            </span>Voucher
        </a>
    </nav>

    <div class="cf-sidebar-section">QUẢN LÝ NGƯỜI DÙNG</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "customers".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/customers">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>Tài khoản Khách hàng
        </a>
        <a class="<%= "managers".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/managers">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>Tài khoản Quản lý
        </a>
        <a class="<%= "transfers".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/transfers">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
            </span>Bổ nhiệm &amp; Điều chuyển
        </a>
        <a class="<%= "staff-history".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/admin/transfers/history">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </span>Nhật ký nhân sự
        </a>
    </nav>

    <div class="cf-sidebar-section">BÁO CÁO &amp; PHÂN TÍCH</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "report-sales".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/report/sales">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </span>Doanh thu &amp; bán hàng
        </a>
        <a class="<%= "report-operations".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/report/operations">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            </span>Chỉ số vận hành
        </a>
        <a class="<%= "payments".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/staff/payments">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </span>Theo dõi giao dịch
        </a>
    </nav>

    <div class="cf-sidebar-section">TÀI KHOẢN</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "account".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/account">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>Hồ sơ của tôi
        </a>
        <a href="<%= cfPath %>/logout">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            </span>Đăng xuất
        </a>
    </nav>
</aside>

<script>
    (function () {
        var sidebar = document.getElementById('adminSidebar') || document.querySelector('.cf-sidebar');
        if (!sidebar) return;

        var storageKey = 'cf_admin_sidebar_scroll';

        function restoreSidebarScroll() {
            var saved = sessionStorage.getItem(storageKey);
            if (saved !== null) {
                sidebar.style.scrollBehavior = 'auto';
                sidebar.scrollTop = parseInt(saved, 10) || 0;
            } else {
                var activeLink = sidebar.querySelector('a.active');
                if (activeLink) {
                    activeLink.scrollIntoView({ block: 'nearest' });
                }
            }
        }

        // Khôi phục ngay khi DOM sẵn sàng
        restoreSidebarScroll();
        window.addEventListener('DOMContentLoaded', restoreSidebarScroll);
        requestAnimationFrame(restoreSidebarScroll);

        // Lưu vị trí khi cuộn
        sidebar.addEventListener('scroll', function () {
            sessionStorage.setItem(storageKey, sidebar.scrollTop);
        }, { passive: true });

        // Lưu vị trí khi click bất kỳ link nào
        sidebar.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () {
                sessionStorage.setItem(storageKey, sidebar.scrollTop);
            });
        });

        window.addEventListener('beforeunload', function () {
            sessionStorage.setItem(storageKey, sidebar.scrollTop);
        });
    })();
</script>
