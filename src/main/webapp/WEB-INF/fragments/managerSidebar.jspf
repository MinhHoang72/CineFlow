<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    String cfPath = request.getContextPath();
    Object cfForwardUri = request.getAttribute("jakarta.servlet.forward.request_uri");
    String cfUri = cfForwardUri == null ? request.getRequestURI() : cfForwardUri.toString();
    String cfActiveNav = (String) request.getAttribute("activeNav");
    if (cfActiveNav == null) cfActiveNav = "";
%>
<%
    String cfRole = (String) session.getAttribute("role");
    if (cfRole == null && session.getAttribute("user") instanceof model.entity.User) {
        cfRole = ((model.entity.User) session.getAttribute("user")).getRole();
    }
    boolean isManagerOrAdmin = "MANAGER".equalsIgnoreCase(cfRole) || "ADMIN".equalsIgnoreCase(cfRole);
%>
<aside class="cf-sidebar cf-manager-sidebar" id="managerSidebar" aria-label="Điều hướng quản lý">
    <a class="cf-sidebar-brand" href="<%= cfPath %>/manager/dashboard">Cine<span>Flow</span></a>
    <div class="cf-sidebar-section">TỔNG QUAN</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "dashboard".equals(cfActiveNav) || cfUri.contains("/dashboard") || cfUri.endsWith("/manager") ? "active" : "" %>" href="<%= cfPath %>/manager/dashboard">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3z"/><path d="M9 20v-7h6v7"/></svg></span>Dashboard
        </a>
    </nav>

    <% if (isManagerOrAdmin) { %>
    <div class="cf-sidebar-section">PHÒNG CHIẾU</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "halls".equals(cfActiveNav) || cfUri.contains("/halls") || cfUri.contains("/seat-config") ? "active" : "" %>" href="<%= cfPath %>/manager/halls">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5m8-5v5"/></svg></span>Quản lý Phòng chiếu &amp; Ghế
        </a>
    </nav>

    <div class="cf-sidebar-section">SUẤT CHIẾU &amp; GIÁ VÉ</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "showtimes".equals(cfActiveNav) || cfUri.contains("/showtimes") ? "active" : "" %>" href="<%= cfPath %>/showtimes"><span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-13 5h3"/></svg></span>Quản lý suất chiếu</a>
        <a class="<%= "pricing".equals(cfActiveNav) || cfUri.contains("/pricing") ? "active" : "" %>" href="<%= cfPath %>/pricing"><span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13 11 22 2 13V3h10z"/><circle cx="7" cy="8" r="1"/></svg></span>Giá vé &amp; Phụ thu</a>
    </nav>

    <div class="cf-sidebar-section">NHÂN SỰ</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "staff".equals(cfActiveNav) || cfUri.endsWith("/staff") ? "active" : "" %>" href="<%= cfPath %>/staff">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m3-13a3 3 0 0 1 0 6m1 3a5 5 0 0 1 2 4"/></svg></span>Danh sách nhân viên
        </a>
    </nav>

    <div class="cf-sidebar-section">BÁO CÁO</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= cfUri.contains("/reports") ? "active" : "" %>" href="<%= cfPath %>/reports">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16v18H4zM8 8h8M8 12h8M8 16h5"/></svg></span>Phân tích hoạt động
        </a>
        <a class="<%= cfUri.contains("/report/sales") ? "active" : "" %>" href="<%= cfPath %>/report/sales">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18M7 15l4-5 4 3 5-8"/></svg></span>Doanh thu &amp; bán hàng
        </a>
        <a class="<%= cfUri.contains("/report/operations") ? "active" : "" %>" href="<%= cfPath %>/report/operations">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10m8 10V4m8 16v-7"/><circle cx="4" cy="7" r="2"/><circle cx="12" cy="17" r="2"/><circle cx="20" cy="10" r="2"/></svg></span>Chỉ số vận hành
        </a>
    </nav>
    <% } %>
    <% if ("MANAGER".equalsIgnoreCase(cfRole)) { %>
    <div class="cf-sidebar-section">KHUYẾN MÃI</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= cfUri.contains("/manager/vouchers") ? "active" : "" %>" href="<%= cfPath %>/manager/vouchers">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4zM15 6v12"/></svg></span>Voucher cụm rạp
        </a>
    </nav>
    <% } %>

    <% if ("MANAGER".equalsIgnoreCase(cfRole) || "TICKET_SALES_STAFF".equalsIgnoreCase(cfRole) || "STAFF".equalsIgnoreCase(cfRole)) { %>
    <div class="cf-sidebar-section">BÁN VÉ</div>
    <%-- URL that truoc khi servlet forward sang JSP (getRequestURI tra ve duong dan file JSP) --%>
    <% Object cfFwd = request.getAttribute("jakarta.servlet.forward.request_uri");
       String cfSalesUrl = cfFwd != null ? cfFwd.toString() : cfUri; %>
    <nav class="cf-sidebar-nav">
        <% if (!"MANAGER".equalsIgnoreCase(cfRole)) { %>
        <a class="<%= cfSalesUrl.contains("/staff/counter") ? "active" : "" %>" href="<%= cfPath %>/staff/counter">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4zM15 6v12"/></svg></span>Bán vé tại quầy
        </a>
        <a class="<%= cfSalesUrl.contains("/staff/fnb-sale") ? "active" : "" %>" href="<%= cfPath %>/staff/fnb-sale">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 2 13h10l2-13zM4 8h16M8 8V4m4 4V3m4 5V4"/></svg></span>Bán bắp nước lẻ
        </a>
        <% } %>
        <a class="<%= cfSalesUrl.contains("/staff/payments") ? "active" : "" %>" href="<%= cfPath %>/staff/payments">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 9h1m10 6h1"/></svg></span>Theo dõi giao dịch
        </a>
    </nav>
    <% } %>

    <% if ("MANAGER".equalsIgnoreCase(cfRole) || "TICKET_SALES_STAFF".equalsIgnoreCase(cfRole)) { %>
    <div class="cf-sidebar-section">BẮP NƯỚC</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= cfUri.endsWith("/fnb") || cfUri.contains("/fnb/item") || cfUri.contains("/fnb/combo") ? "active" : "" %>" href="<%= cfPath %>/fnb">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 2 13h10l2-13zM4 8h16M8 8V4m4 4V3m4 5V4"/></svg></span>Món &amp; Combo
        </a>
        <a class="<%= cfUri.contains("/fnb/stock") ? "active" : "" %>" href="<%= cfPath %>/fnb/stock">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 7 9-4 9 4-9 4zM3 7v10l9 4 9-4V7M12 11v10"/></svg></span>Kho theo cụm rạp
        </a>
    </nav>
    <% } %>

    <% if ("MANAGER".equalsIgnoreCase(cfRole) || "TICKET_CHECKER_STAFF".equalsIgnoreCase(cfRole)) { %>
    <div class="cf-sidebar-section">VẬN HÀNH</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= cfUri.contains("/checkin") ? "active" : "" %>" href="<%= cfPath %>/checkin">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v8H4V4h11m-6 7 4 4L22 5"/></svg></span>Soát vé
        </a>
    </nav>
    <% } %>

    <div class="cf-sidebar-section">TÀI KHOẢN</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "account".equals(cfActiveNav) || cfUri.contains("/account") || cfUri.contains("/profile") ? "active" : "" %>" href="<%= cfPath %>/account">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></span>Hồ sơ của tôi
        </a>
        <a href="<%= cfPath %>/logout">
            <span class="icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H4v16h5m5-13 5 5-5 5M8 12h13"/></svg></span>Đăng xuất
        </a>
    </nav>
</aside>

