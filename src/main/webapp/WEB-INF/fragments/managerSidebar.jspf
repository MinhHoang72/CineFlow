<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    String cfPath = request.getContextPath();

    // 1. Xác định vai trò của người dùng
    String cfRole = (String) session.getAttribute("role");
    if (cfRole == null && session.getAttribute("user") instanceof model.entity.User) {
        cfRole = ((model.entity.User) session.getAttribute("user")).getRole();
    }
    if (cfRole == null) {
        cfRole = "";
    }
    boolean isManager = "MANAGER".equalsIgnoreCase(cfRole) || "ADMIN".equalsIgnoreCase(cfRole);
    boolean isSales = "TICKET_SALES_STAFF".equalsIgnoreCase(cfRole) || "TICKET_SALES".equalsIgnoreCase(cfRole);
    boolean isChecker = "TICKET_CHECKER_STAFF".equalsIgnoreCase(cfRole) || "TICKET_CHECKER".equalsIgnoreCase(cfRole);
    boolean isGenericStaff = "STAFF".equalsIgnoreCase(cfRole);
    boolean isStaff = isSales || isChecker || isGenericStaff;

    String brandUrl = isStaff ? (cfPath + "/dashboard") : (cfPath + "/manager/dashboard");
    String dashboardUrl = isStaff ? (cfPath + "/dashboard") : (cfPath + "/manager/dashboard");

    // 2. Lấy URI và ServletPath gốc (hỗ trợ cả các trường hợp request được forward qua Servlet)
    String originalUri = (String) request.getAttribute("jakarta.servlet.forward.request_uri");
    if (originalUri == null || originalUri.isBlank()) {
        originalUri = request.getRequestURI();
    }

    String originalServletPath = (String) request.getAttribute("jakarta.servlet.forward.servlet_path");
    if (originalServletPath == null || originalServletPath.isBlank()) {
        originalServletPath = request.getServletPath();
    }

    String pathInfo = (String) request.getAttribute("jakarta.servlet.forward.path_info");
    if (pathInfo == null) {
        pathInfo = request.getPathInfo();
    }

    String fullReqPath = (originalServletPath != null ? originalServletPath : "") + (pathInfo != null ? pathInfo : "");
    if (fullReqPath.isEmpty()) {
        fullReqPath = originalUri;
    }

    String jspUri = request.getRequestURI();

    String activeNav = (String) request.getAttribute("activeNav");
    if (activeNav == null || activeNav.isBlank() || "report-hub".equals(activeNav)) {
        if (fullReqPath.contains("/staff/counter") || fullReqPath.contains("counter")) {
            activeNav = "counter";
        } else if (fullReqPath.contains("/showtimes") || jspUri.contains("showtime")) {
            activeNav = "showtimes";
        } else if (fullReqPath.contains("/pricing") || jspUri.contains("pricing")) {
            activeNav = "pricing";
        } else if (fullReqPath.contains("/halls") || fullReqPath.contains("/seats") || jspUri.contains("hall") || jspUri.contains("seat")) {
            activeNav = "halls";
        } else if (fullReqPath.contains("/fnb/stock") || (fullReqPath.contains("/fnb") && "/stock".equals(pathInfo)) || jspUri.contains("fnbInventory")) {
            activeNav = "fnb-stock";
        } else if (fullReqPath.contains("/fnb") || jspUri.contains("fnb")) {
            activeNav = "fnb";
        } else if (fullReqPath.contains("/checkin") || jspUri.contains("ticketCheckIn") || jspUri.contains("checkin")) {
            activeNav = "checkin";
        } else if (fullReqPath.contains("/payments") || jspUri.contains("paymentHistory")) {
            activeNav = "payments";
        } else if (fullReqPath.contains("/vouchers") || jspUri.contains("voucher")) {
            activeNav = "vouchers";
        } else if (fullReqPath.contains("/report/operations") || fullReqPath.contains("/operations") || jspUri.contains("reportOperations")) {
            activeNav = "report-operations";
        } else if (fullReqPath.contains("/report/sales") || fullReqPath.contains("/sales") || jspUri.contains("reportSales")) {
            activeNav = "report-sales";
        } else if (fullReqPath.contains("/staffList") || jspUri.contains("staffList") || (fullReqPath.contains("/staff") && !fullReqPath.contains("payment") && !fullReqPath.contains("checkin") && !fullReqPath.contains("counter"))) {
            activeNav = "staff";
        } else if (fullReqPath.contains("/account") || fullReqPath.contains("/profile") || jspUri.contains("userProfile") || jspUri.contains("profile")) {
            activeNav = "account";
        } else if (fullReqPath.contains("/dashboard") || fullReqPath.endsWith("/manager") || jspUri.contains("managerDashboard") || jspUri.contains("staffDashboard")) {
            activeNav = "dashboard";
        } else {
            activeNav = "";
        }
    }
%>
<aside class="cf-sidebar" id="managerSidebar">
    <a class="cf-sidebar-brand" href="<%= brandUrl %>">Cine<span>Flow</span></a>

    <div class="cf-sidebar-section">TỔNG QUAN</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "dashboard".equals(activeNav) ? "active" : "" %>" href="<%= dashboardUrl %>">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </span>Dashboard
        </a>
    </nav>

    <% if (isStaff) { %>
        <% if (isSales || isGenericStaff) { %>
            <div class="cf-sidebar-section">QUẦY VÉ &amp; BẮP NƯỚC</div>
            <nav class="cf-sidebar-nav">
                <a class="<%= "counter".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/staff/counter">
                    <span class="icon">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"></path><line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2 2"></line></svg>
                    </span>Bán vé tại quầy
                </a>
                <a class="<%= "fnb-stock".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/fnb/stock">
                    <span class="icon">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </span>Kho hàng chi nhánh
                </a>
                <a class="<%= "payments".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/staff/payments">
                    <span class="icon">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    </span>Theo dõi giao dịch
                </a>
            </nav>
        <% } %>

        <% if (isChecker || isGenericStaff) { %>
            <div class="cf-sidebar-section">SOÁT VÉ CỬA RẠP</div>
            <nav class="cf-sidebar-nav">
                <a class="<%= "checkin".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/checkin">
                    <span class="icon">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    </span>Soát vé Check-in
                </a>
            </nav>
        <% } %>
    <% } else { %>
        <div class="cf-sidebar-section">VẬN HÀNH RẠP CHIẾU</div>
        <nav class="cf-sidebar-nav">
            <a class="<%= "showtimes".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/showtimes">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="17" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>
                </span>Lịch chiếu phim
            </a>
            <a class="<%= "pricing".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/pricing">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </span>Bảng giá vé &amp; Phụ thu
            </a>
            <a class="<%= "halls".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/manager/halls">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                </span>Phòng chiếu &amp; Ghế
            </a>
        </nav>

        <div class="cf-sidebar-section">QUẢN LÝ NHÂN SỰ</div>
        <nav class="cf-sidebar-nav">
            <a class="<%= "staff".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/staffList">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </span>Danh sách nhân viên
            </a>
        </nav>

        <div class="cf-sidebar-section">DỊCH VỤ BẮP NƯỚC</div>
        <nav class="cf-sidebar-nav">
            <a class="<%= "fnb".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/fnb">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                </span>Món &amp; Combo
            </a>
            <a class="<%= "fnb-stock".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/fnb/stock">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                </span>Kho hàng chi nhánh
            </a>
        </nav>

        <div class="cf-sidebar-section">BÁN VÉ &amp; VẬN HÀNH</div>
        <nav class="cf-sidebar-nav">
            <a class="<%= "checkin".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/checkin">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                </span>Soát vé Check-in
            </a>
            <a class="<%= "payments".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/manager/payments">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                </span>Theo dõi giao dịch
            </a>
        </nav>

        <div class="cf-sidebar-section">KHUYẾN MÃI</div>
        <nav class="cf-sidebar-nav">
            <a class="<%= "vouchers".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/manager/vouchers">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"></path><line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2 2"></line></svg>
                </span>Voucher chi nhánh
            </a>
        </nav>

        <div class="cf-sidebar-section">BÁO CÁO &amp; PHÂN TÍCH</div>
        <nav class="cf-sidebar-nav">
            <a class="<%= "report-operations".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/report/operations">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                </span>Chỉ số vận hành
            </a>
            <a class="<%= "report-sales".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/report/sales">
                <span class="icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </span>Doanh thu &amp; Bán hàng
            </a>
        </nav>
    <% } %>

    <div class="cf-sidebar-section">TÀI KHOẢN</div>
    <nav class="cf-sidebar-nav">
        <a class="<%= "account".equals(activeNav) ? "active" : "" %>" href="<%= cfPath %>/account">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>Hồ sơ của tôi
        </a>
        <a href="<%= cfPath %>/logout">
            <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            </span>Đăng xuất
        </a>
    </nav>
</aside>

<script>
    (function () {
        var sidebar = document.getElementById('managerSidebar') || document.querySelector('.cf-sidebar');
        if (!sidebar) return;

        var storageKey = 'cf_manager_sidebar_scroll';

        function restoreSidebarScroll() {
            var saved = sessionStorage.getItem(storageKey);
            if (saved !== null) {
                sidebar.style.scrollBehavior = 'auto';
                sidebar.scrollTop = parseInt(saved, 10) || 0;
            } else {
                var activeLink = sidebar.querySelector('a.active');
                if (activeLink) {
                    activeLink.scrollIntoView({ block: 'nearest' });
                }
            }
        }

        // Khôi phục ngay khi DOM sẵn sàng
        restoreSidebarScroll();
        window.addEventListener('DOMContentLoaded', restoreSidebarScroll);
        requestAnimationFrame(restoreSidebarScroll);

        // Lưu vị trí khi cuộn
        sidebar.addEventListener('scroll', function () {
            sessionStorage.setItem(storageKey, sidebar.scrollTop);
        }, { passive: true });

        // Lưu vị trí khi click bất kỳ link nào
        sidebar.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () {
                sessionStorage.setItem(storageKey, sidebar.scrollTop);
            });
        });

        window.addEventListener('beforeunload', function () {
            sessionStorage.setItem(storageKey, sidebar.scrollTop);
        });
    })();
</script>
