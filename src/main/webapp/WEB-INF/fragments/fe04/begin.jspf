<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%
    String fe04Role = (String) session.getAttribute("role");
    if (fe04Role == null && session.getAttribute("user") instanceof model.entity.User) fe04Role = ((model.entity.User) session.getAttribute("user")).getRole();
    boolean fe04Admin = "ADMIN".equalsIgnoreCase(fe04Role);
    request.setAttribute("activeNav", "showtimes".equals(request.getAttribute("fe04Tab")) ? "showtimes" : "pricing");
    request.setAttribute("pageTitle", request.getAttribute("fe04Title"));
    request.setAttribute("pageBreadcrumb", "Suất chiếu & giá vé");
%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${fe04Title}" /> | CineFlow</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin/dashboard.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/showtime-pricing/showtimes.css">
<script src="${pageContext.request.contextPath}/js/pricing.js" defer></script>
</head><body><div class="cf-manager-shell">
<jsp:include page='<%= fe04Admin ? "/WEB-INF/views/admin/adminSidebar.jspf" : "/WEB-INF/views/manager/managerSidebar.jspf" %>' />
<div class="cf-manager-main"><jsp:include page="/WEB-INF/views/admin/adminTopbar.jspf" /><main class="cf-content st-page">
<header class="st-heading"><div><span class="st-eyebrow">ĐIỀU HÀNH RẠP CHIẾU</span><h1><c:out value="${fe04Title}" /></h1><p><c:out value="${fe04Description}" /></p></div></header>
<%@ include file="navigation.jspf" %>
<c:if test="${not empty sessionScope.message}"><div class="st-notice st-success" role="status"><c:out value="${sessionScope.message}" /></div><c:remove var="message" scope="session" /></c:if>
<c:if test="${not empty sessionScope.error}"><div class="st-notice st-error" role="alert"><c:out value="${sessionScope.error}" /></div><c:remove var="error" scope="session" /></c:if>
