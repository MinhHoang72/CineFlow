<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN" scope="request"/>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle}"/> - CineFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f5f6fa; }
        .hero { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; padding: 24px 0; }
        .step { display: inline-block; width: 36px; height: 36px; line-height: 36px; text-align: center;
                border-radius: 50%; background: rgba(255,255,255,.25); margin-right: 8px; }
        .card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    </style>
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="${pageContext.request.contextPath}/home/index.jsp">🎬 CineFlow</a>
        <c:if test="${not empty sessionScope.user}">
            <c:set var="cfRole" value="${sessionScope.user.role}"/>
            <c:set var="cfSales" value="${cfRole == 'TICKET_SALES_STAFF' or cfRole == 'STAFF'}"/>
            <span class="navbar-text text-light">
                <c:if test="${cfRole == 'CUSTOMER'}">
                    <a class="link-warning me-3" href="${pageContext.request.contextPath}/booking?action=history">Lịch sử đặt vé</a>
                </c:if>
                <c:if test="${cfSales and not empty sessionScope.user.centreId}">
                    <a class="link-warning me-3" href="${pageContext.request.contextPath}/staff/counter">Bán vé tại quầy</a>
                </c:if>
                <c:if test="${cfSales or cfRole == 'MANAGER' or cfRole == 'ADMIN'}">
                    <a class="link-warning me-3" href="${pageContext.request.contextPath}/staff/payments">Theo dõi giao dịch</a>
                </c:if>
                Xin chào, <c:out value="${sessionScope.user.fullName}"/>
                · <a class="link-light" href="${pageContext.request.contextPath}/logout">Đăng xuất</a></span>
        </c:if>
    </div>
</nav>
<div class="hero">
    <div class="container">
        <h3 class="mb-0"><span class="step">${pageStep}</span><c:out value="${pageTitle}"/></h3>
    </div>
</div>
<div class="container py-4">
<c:if test="${not empty sessionScope.flashMessage}">
    <div class="alert alert-${sessionScope.flashType} alert-dismissible fade show">
        <c:out value="${sessionScope.flashMessage}"/>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <c:remove var="flashMessage" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
