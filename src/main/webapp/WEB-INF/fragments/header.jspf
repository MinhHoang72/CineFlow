<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%-- Khung trang dat ve / thanh toan (dong bang footer.jspf).
     Khach: header + footer chung cua trang chu. Nhan vien / quan ly / admin: khung sidebar + topbar cua nhom.
     Trang dat truoc: pageTitle, pageStep (request scope). --%>
<fmt:setLocale value="vi_VN" scope="request"/>
<c:set var="cfRole" value="${sessionScope.user.role}"/>
<c:set var="cfStaffShell" value="${cfRole == 'TICKET_SALES_STAFF' or cfRole == 'STAFF' or cfRole == 'TICKET_CHECKER_STAFF'
                                   or cfRole == 'MANAGER' or cfRole == 'ADMIN'}" scope="request"/>
<c:if test="${empty pageBreadcrumb}"><c:set var="pageBreadcrumb" value="Đặt vé và thanh toán" scope="request"/></c:if>
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle}"/> | CineFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <c:choose>
        <c:when test="${cfStaffShell}">
            <link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/shell.css">
        </c:when>
        <c:otherwise>
            <link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/layout.css">
        </c:otherwise>
    </c:choose>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/booking/booking.css?v=<%= application.getRealPath("/css/booking/booking.css") == null ? "1" : new java.io.File(application.getRealPath("/css/booking/booking.css")).lastModified() %>">
</head>
<body class="cf-booking ${cfStaffShell ? 'cf-booking-staff' : 'cf-booking-site'}">
<c:choose>
    <c:when test="${cfStaffShell}">
<div class="cf-manager-shell">
    <jsp:include page="${cfRole == 'ADMIN' ? '/WEB-INF/fragments/adminSidebar.jspf' : '/WEB-INF/fragments/managerSidebar.jspf'}"/>
    <div class="cf-manager-main">
        <jsp:include page="${cfRole == 'ADMIN' ? '/WEB-INF/fragments/adminTopbar.jspf' : '/WEB-INF/fragments/managerTopbar.jspf'}"/>
        <main class="cf-content cf-booking-content">
    </c:when>
    <c:otherwise>
<jsp:include page="/common/header.jsp">
    <jsp:param name="activeNav" value="booking"/>
</jsp:include>
<main class="cf-booking-content container">
    <header class="cf-booking-heading">
        <span class="cf-booking-step">${pageStep}</span>
        <div>
            <span class="cf-booking-eyebrow">CINEFLOW · ĐẶT VÉ</span>
            <h1><c:out value="${pageTitle}"/></h1>
        </div>
    </header>
    </c:otherwise>
</c:choose>
<c:if test="${not empty sessionScope.flashMessage}">
    <div class="alert alert-${sessionScope.flashType} alert-dismissible fade show">
        <c:out value="${sessionScope.flashMessage}"/>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <c:remove var="flashMessage" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
