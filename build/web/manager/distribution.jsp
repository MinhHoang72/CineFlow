<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="model.Movie,model.Branch,java.util.List" %>
<% Movie movie=(Movie)request.getAttribute("movie"); List<Branch> branches=(List<Branch>)request.getAttribute("branches"); int activeCount=0,selectedCount=0; boolean allActive=true; for(Branch b:branches){if("ACTIVE".equalsIgnoreCase(b.getStatus())){activeCount++;if(b.isDistributed())selectedCount++;else allActive=false;}} if(activeCount==0)allActive=false; %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Phân phối phim | CineFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/shell.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/alerts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/distribution.css"></head><body><div class="cf-manager-shell"><jsp:include page="/manager/sidebar.jsp"/><div class="cf-manager-main"><jsp:include page="/manager/topbar.jsp"/><main class="cf-content">
<div class="cf-page-header"><div><p class="cf-breadcrumb">Quản lý phim / Phân phối phim</p><h1>Phân phối phim</h1><p>Thiết lập các trung tâm được phép phát hành phim.</p></div><a class="cf-btn cf-btn-secondary" href="${pageContext.request.contextPath}/manager/movies">← Danh mục phim</a></div><%if("1".equals(request.getParameter("saved"))){%><div class="cf-alert cf-alert-success">Đã lưu phạm vi phân phối cho phim.</div><%}%>
<section class="cf-card cf-selected-movie"><div class="cf-movie-poster"><%if(movie.getPosterUrl()!=null&&!movie.getPosterUrl().isBlank()){%><img src="<%=movie.getPosterUrl()%>" alt=""><%}else{%>🎬<%}%></div><div><span class="cf-label">PHIM ĐƯỢC CHỌN</span><h2><%=movie.getTitle()%></h2><p><%=movie.getGenre()==null?"Chưa có thể loại":movie.getGenre()%> · <%=movie.getAgeRating()%> · <%=movie.getDuration()%> phút</p><small>Mã phim #<%=movie.getMovieId()%></small></div></section>
<form class="cf-card" method="post" action="${pageContext.request.contextPath}/manager/distribution"><input type="hidden" name="movieId" value="<%=movie.getMovieId()%>"><div class="cf-card-header"><div><h2>Phạm vi phân phối</h2><p>Manager có thể phân phối phim trên toàn hệ thống hoặc chọn từng trung tâm.</p></div></div><div class="cf-scope-options"><label class="cf-scope-option"><input type="radio" name="scope" value="system" <%=allActive?"checked":""%> onchange="changeScope('system')"><span><b>Toàn hệ thống</b><small>Phân phối đến tất cả trung tâm đang hoạt động.</small></span></label><label class="cf-scope-option"><input type="radio" name="scope" value="selected" <%=allActive?"":"checked"%> onchange="changeScope('selected')"><span><b>Chọn trung tâm</b><small>Chỉ phân phối đến các trung tâm được tích chọn.</small></span></label></div><div id="systemScope" class="cf-scope-panel"><b>Tất cả trung tâm đang hoạt động</b><p>Phim sẽ được phân phối đến <strong><%=activeCount%></strong> trung tâm.</p><div class="cf-hint">Trung tâm không hoạt động sẽ không được phân phối phim.</div></div><div id="selectedScope" class="cf-scope-panel"><div class="cf-scope-head"><div><b>Danh sách trung tâm</b><p>Tích chọn các trung tâm đang hoạt động.</p></div><span>Đã chọn: <strong id="selectedCount"><%=selectedCount%></strong></span></div><div class="cf-centre-list"><%for(Branch b:branches){boolean ok="ACTIVE".equalsIgnoreCase(b.getStatus());%><label class="cf-centre <%=ok?"":"disabled"%>"><input type="checkbox" name="branchIds" value="<%=b.getBranchId()%>" <%=b.isDistributed()?"checked":""%> <%=ok?"":"disabled"%> onchange="updateCount()"><span><b><%=b.getBranchName()%></b><small><%=b.getCity()==null?"":b.getCity()%> · <%=b.getAddress()==null?"":b.getAddress()%></small></span><em><%=ok?"Đang hoạt động":"Không hoạt động"%></em></label><%}%></div></div><div class="cf-form-actions"><a class="cf-btn cf-btn-secondary" href="${pageContext.request.contextPath}/manager/movies">Hủy</a><button class="cf-btn cf-btn-primary" type="submit">Lưu phân phối</button></div></form>
</main></div></div><script>const systemScope=document.getElementById('systemScope'),selectedScope=document.getElementById('selectedScope'),boxes=()=>Array.from(document.querySelectorAll('input[name="branchIds"]:not(:disabled)'));function changeScope(scope){systemScope.hidden=scope!=='system';selectedScope.hidden=scope==='system';if(scope==='system')boxes().forEach(box=>box.checked=true);updateCount()}function updateCount(){document.getElementById('selectedCount').textContent=boxes().filter(box=>box.checked).length}changeScope(document.querySelector('input[name="scope"]:checked').value);</script></body></html>



