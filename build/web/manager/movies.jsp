<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="model.Movie,java.util.List" %>
<% List<Movie> movies=(List<Movie>)request.getAttribute("movies"); String role=(String)session.getAttribute("role"); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Danh mục phim | CineFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/shell.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/tables.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/badges.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/alerts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/movies.css"></head><body><div class="cf-manager-shell"><jsp:include page="/manager/sidebar.jsp"/><div class="cf-manager-main"><jsp:include page="/manager/topbar.jsp"/><main class="cf-content">
<div class="cf-page-header"><div><p class="cf-breadcrumb">Quản lý phim / Danh mục phim</p><h1>Danh mục phim</h1><p>Quản lý thông tin, trạng thái phát hành và phân phối phim.</p></div><a class="cf-btn cf-btn-primary" href="${pageContext.request.contextPath}/manager/movie">+ Thêm phim mới</a></div>
<section class="cf-card"><div class="cf-card-header"><div><h2>Danh sách phim</h2><p><%=movies==null?0:movies.size()%> phim trong hệ thống.</p></div></div><div class="cf-card-body"><div class="cf-table-wrap"><table class="cf-table"><thead><tr><th>Phim</th><th>Thể loại</th><th>Độ tuổi</th><th>Thời lượng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<%if(movies==null||movies.isEmpty()){%><tr><td colspan="6" class="cf-empty">Chưa có phim nào trong hệ thống.</td></tr><%}else for(Movie movie:movies){String status=movie.getStatus();String text="COMING_SOON".equals(status)?"Sắp chiếu":"NOW_SHOWING".equals(status)?"Đang chiếu":"ENDED".equals(status)?"Đã kết thúc":"Đã lưu trữ";String badge="NOW_SHOWING".equals(status)?"cf-badge-success":"COMING_SOON".equals(status)?"cf-badge-info":"ENDED".equals(status)?"cf-badge-warning":"cf-badge-muted";%><tr><td><div class="movie-cell"><div class="movie-thumb"><%if(movie.getPosterUrl()!=null&&!movie.getPosterUrl().isBlank()){%><img src="<%=movie.getPosterUrl()%>" alt=""><%}else{%>🎬<%}%></div><div><a href="${pageContext.request.contextPath}/manager/movie?movieId=<%=movie.getMovieId()%>"><strong><%=movie.getTitle()%></strong></a><small>#<%=movie.getMovieId()%></small></div></div></td><td><%=movie.getGenre()==null?"Chưa cập nhật":movie.getGenre()%></td><td><span class="cf-badge cf-badge-muted"><%=movie.getAgeRating()%></span></td><td><%=movie.getDuration()%> phút</td><td><span class="cf-badge <%=badge%>"><%=text%></span></td><td><div class="cf-table-actions"><a class="cf-btn cf-btn-secondary cf-btn-sm" href="${pageContext.request.contextPath}/manager/movie?movieId=<%=movie.getMovieId()%>">Sửa</a><%if("MANAGER".equals(role)){%><a class="cf-btn cf-btn-ghost cf-btn-sm" href="${pageContext.request.contextPath}/manager/distribution?movieId=<%=movie.getMovieId()%>">Phân phối</a><%}%></div></td></tr><%}%>
</tbody></table></div></div></section></main></div></div></body></html>



