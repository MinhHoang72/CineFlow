<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="model.Movie" %>
<% Movie movie=(Movie)request.getAttribute("movie"); boolean editing=movie!=null; String age=editing?movie.getAgeRating():"P"; String status=editing?movie.getStatus():"COMING_SOON"; %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=editing?"Chỉnh sửa phim":"Thêm phim mới"%> | CineFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/shell.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/forms.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/alerts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/movie-form.css"></head><body><div class="cf-manager-shell"><jsp:include page="/manager/sidebar.jsp"/><div class="cf-manager-main"><jsp:include page="/manager/topbar.jsp"/><main class="cf-content">
<div class="cf-page-header"><div><p class="cf-breadcrumb">Quản lý phim / <%=editing?"Chỉnh sửa":"Thêm mới"%></p><h1><%=editing?"Chỉnh sửa phim":"Thêm phim mới"%></h1><p>Thông tin phim được lưu trực tiếp vào danh mục CineFlow.</p></div></div>
<form class="cf-card" method="post" action="${pageContext.request.contextPath}/manager/movie" enctype="multipart/form-data"><input type="hidden" name="action" value="save"><%if(editing){%><input type="hidden" name="movieId" value="<%=movie.getMovieId()%>"><%}%><div class="cf-card-header"><div><h2>Thông tin phim</h2><p>Các trường có dấu <b>*</b> là bắt buộc.</p></div></div><div class="cf-card-body"><div class="cf-form-grid"><div class="cf-field"><label>Mã phim</label><input value="<%=editing?movie.getMovieId():"Tự động tạo"%>" readonly></div><div class="cf-field"><label>Tên phim <span>*</span></label><input name="title" value="<%=editing?movie.getTitle():""%>" required></div><div class="cf-field"><label>Thể loại</label><input name="genre" value="<%=editing&&movie.getGenre()!=null?movie.getGenre():""%>"></div><div class="cf-field"><label>Độ tuổi <span>*</span></label><select name="ageRating"><option value="P" <%="P".equals(age)?"selected":""%>>P</option><option value="K" <%="K".equals(age)?"selected":""%>>K</option><option value="T13" <%="T13".equals(age)?"selected":""%>>T13</option><option value="T16" <%="T16".equals(age)?"selected":""%>>T16</option><option value="T18" <%="T18".equals(age)?"selected":""%>>T18</option><option value="C" <%="C".equals(age)?"selected":""%>>C</option></select></div><div class="cf-field"><label>Thời lượng (phút) <span>*</span></label><input name="duration" type="number" min="1" value="<%=editing?movie.getDuration():""%>" required></div><div class="cf-field"><label>Ngày phát hành</label><input name="releaseDate" type="date" value="<%=editing&&movie.getReleaseDate()!=null?movie.getReleaseDate():""%>"></div><div class="cf-field"><label>Ngày kết thúc</label><input name="endDate" type="date" value="<%=editing&&movie.getEndDate()!=null?movie.getEndDate():""%>"></div><div class="cf-field"><label>Trạng thái <span>*</span></label><select name="status"><option value="COMING_SOON" <%="COMING_SOON".equals(status)?"selected":""%>>Sắp chiếu</option><option value="NOW_SHOWING" <%="NOW_SHOWING".equals(status)?"selected":""%>>Đang chiếu</option><option value="ENDED" <%="ENDED".equals(status)?"selected":""%>>Đã kết thúc</option><option value="ARCHIVED" <%="ARCHIVED".equals(status)?"selected":""%>>Đã lưu trữ</option></select></div><div class="cf-field"><label>Đạo diễn</label><input name="director" value="<%=editing&&movie.getDirector()!=null?movie.getDirector():""%>"></div><div class="cf-field"><label>Diễn viên</label><input name="cast" value="<%=editing&&movie.getCast()!=null?movie.getCast():""%>"></div><div class="cf-field"><label>Ngôn ngữ</label><input name="language" value="<%=editing&&movie.getLanguage()!=null?movie.getLanguage():""%>"></div><div class="cf-field cf-field-full"><label>Nội dung phim</label><textarea name="description"><%=editing&&movie.getDescription()!=null?movie.getDescription():""%></textarea></div></div><div class="media-fields"><div class="cf-field"><label>Áp phích</label><input name="posterFile" type="file" accept="image/png,image/jpeg"><input name="posterUrl" value="<%=editing&&movie.getPosterUrl()!=null?movie.getPosterUrl():""%>" placeholder="Hoặc nhập URL poster"><small class="cf-help">PNG/JPG hoặc URL. File được lưu trong ứng dụng.</small></div><div class="cf-field"><label>Trailer</label><input name="trailerFile" type="file" accept="video/mp4,video/webm,video/ogg"><input name="trailerUrl" value="<%=editing&&movie.getTrailerUrl()!=null?movie.getTrailerUrl():""%>" placeholder="Hoặc nhập URL trailer"><small class="cf-help">MP4, WebM, OGG hoặc URL.</small></div></div></div><div class="cf-form-actions"><a class="cf-btn cf-btn-secondary" href="${pageContext.request.contextPath}/manager/movies">Hủy</a><button class="cf-btn cf-btn-primary" type="submit"><%=editing?"Lưu thay đổi":"Thêm phim"%></button></div></form>
<%if(editing){%><section class="cf-card cf-danger-card"><div class="cf-card-body"><h2>Khu vực nguy hiểm</h2><p>Chỉ xóa phim khi chưa có dữ liệu liên quan. Lưu trữ sẽ đưa phim về trạng thái Archived.</p><div class="cf-danger-actions"><form method="post" action="${pageContext.request.contextPath}/manager/movie"><input type="hidden" name="action" value="archive"><input type="hidden" name="movieId" value="<%=movie.getMovieId()%>"><button class="cf-btn cf-btn-secondary" type="submit">Lưu trữ phim</button></form><form method="post" action="${pageContext.request.contextPath}/manager/movie" onsubmit="return confirm('Bạn có chắc muốn xóa phim này?');"><input type="hidden" name="action" value="delete"><input type="hidden" name="movieId" value="<%=movie.getMovieId()%>"><button class="cf-btn cf-btn-danger" type="submit">Xóa phim</button></form></div></div></section><%}%>
</main></div></div></body></html>



