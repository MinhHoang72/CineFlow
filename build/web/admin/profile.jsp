<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="model.User" %>
<%! private String esc(String v){return v==null?"":v.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");} %>
<% User user=(User)request.getAttribute("accountUser"); String error=request.getParameter("error"); String updated=request.getParameter("updated"); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Hồ sơ Admin | CineFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin/dashboard.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin/profile.css"></head><body><div class="admin-layout"><aside class="admin-sidebar"><a class="admin-brand" href="${pageContext.request.contextPath}/dashboard">Cine<span>Flow</span></a><p class="admin-caption">KHU VỰC QUẢN TRỊ</p><nav><a href="${pageContext.request.contextPath}/dashboard"><span>⌂</span> Tổng quan</a><a href="${pageContext.request.contextPath}/reports"><span>▤</span> Báo cáo toàn hệ thống</a><a href="${pageContext.request.contextPath}/staff"><span>♙</span> Quản lý nhân sự</a><a class="active" href="${pageContext.request.contextPath}/account"><span>●</span> Hồ sơ Admin</a></nav><a class="admin-logout" href="${pageContext.request.contextPath}/logout"><span>↪</span> Đăng xuất</a></aside><div class="admin-main"><header class="admin-topbar"><div><span class="top-label">CINEFLOW ADMIN</span><strong>Hồ sơ tài khoản</strong></div></header><main class="admin-content"><div class="profile-heading"><div><p class="eyebrow">TÀI KHOẢN / HỒ SƠ ADMIN</p><h1>Thông tin tài khoản</h1><p>Cập nhật thông tin liên hệ và bảo mật tài khoản quản trị.</p></div><a href="${pageContext.request.contextPath}/dashboard">← Về tổng quan</a></div><%if("true".equals(updated)){%><div class="profile-notice ok">Thông tin hồ sơ đã được cập nhật.</div><%}if("email".equals(error)){%><div class="profile-notice error">Email này đã được sử dụng bởi tài khoản khác.</div><%}if("required".equals(error)){%><div class="profile-notice error">Họ tên và email là thông tin bắt buộc.</div><%}%><div class="profile-grid"><section class="profile-card"><h2>Thông tin cá nhân</h2><p class="muted">Thông tin dùng trong hệ thống CineFlow.</p><form method="post" action="${pageContext.request.contextPath}/account"><label>Họ và tên<input name="fullName" value="<%=esc(user.getFullName())%>" required></label><label>Tên tài khoản<input value="<%=esc(user.getAccount())%>" disabled></label><label>Email<input type="email" name="email" value="<%=esc(user.getEmail())%>" required></label><label>Số điện thoại<input name="phone" value="<%=esc(user.getPhone())%>"></label><label>Ảnh đại diện (URL)<input name="avatar" value="<%=esc(user.getAvatar())%>"></label><button type="submit">Lưu thay đổi</button></form></section><aside class="profile-card summary"><div class="admin-avatar"><%=user.getFullName()==null||user.getFullName().isBlank()?"A":user.getFullName().substring(0,1).toUpperCase()%></div><h2><%=esc(user.getFullName())%></h2><b class="role">ADMIN</b><div class="facts"><span>Trạng thái <strong><%=esc(user.getStatus())%></strong></span><span>Email <strong><%=user.isEmailVerified()?"Đã xác minh":"Chưa xác minh"%></strong></span></div><a class="password" href="${pageContext.request.contextPath}/auth/change-password.jsp">Đổi mật khẩu</a></aside></div></main></div></div></body></html>
