<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="model.ReportSummary,model.RevenueReport,java.util.List" %>
<%! private String money(java.math.BigDecimal n){return String.format("%,.0f đ", n == null ? java.math.BigDecimal.ZERO : n);} %>
<% ReportSummary s=(ReportSummary)request.getAttribute("reportSummary"); List<RevenueReport> branches=(List<RevenueReport>)request.getAttribute("branchRevenue"); List<RevenueReport> movies=(List<RevenueReport>)request.getAttribute("movieRevenue"); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tổng quan toàn hệ thống | CineFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin/reports.css"></head><body><header class="admin-top"><a href="${pageContext.request.contextPath}/dashboard">Cine<span>Flow</span></a><span>ADMIN · TỔNG QUAN TOÀN HỆ THỐNG</span><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></header><main class="admin-content"><div class="heading"><p>PHÂN TÍCH HỆ THỐNG</p><h1>Tổng quan CineFlow</h1><span>Dữ liệu tổng hợp từ toàn bộ trung tâm</span></div><div class="admin-kpis"><div><small>DOANH THU</small><b><%=money(s.getRevenue())%></b></div><div><small>ĐƠN ĐẶT VÉ</small><b><%=s.getBookings()%></b></div><div><small>TRUNG TÂM HOẠT ĐỘNG</small><b><%=s.getActiveBranches()%></b></div><div><small>NGƯỜI DÙNG HOẠT ĐỘNG</small><b><%=s.getActiveUsers()%></b></div></div><section class="admin-panel"><h2>Doanh thu theo trung tâm</h2><table><thead><tr><th>Trung tâm</th><th>Thành phố</th><th>Đơn đặt vé</th><th>Vé bán</th><th>Doanh thu</th></tr></thead><tbody><%for(RevenueReport x:branches){%><tr><td><%=x.getName()%></td><td><%=x.getCity()==null?"—":x.getCity()%></td><td><%=x.getBookings()%></td><td><%=x.getTickets()%></td><td><b><%=money(x.getRevenue())%></b></td></tr><%}%></tbody></table></section><section class="admin-panel"><h2>Xếp hạng phim toàn hệ thống</h2><table><thead><tr><th>Phim</th><th>Vé bán</th><th>Doanh thu</th></tr></thead><tbody><%for(RevenueReport x:movies){%><tr><td><%=x.getName()%></td><td><%=x.getTickets()%></td><td><b><%=money(x.getRevenue())%></b></td></tr><%}%></tbody></table></section></main></body></html>
