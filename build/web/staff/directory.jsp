<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="model.User,model.Branch,java.util.List" %>
<% List<User> staff=(List<User>)request.getAttribute("staff"); List<Branch> branches=(List<Branch>)request.getAttribute("branches"); Integer selectedBranchId=(Integer)request.getAttribute("selectedBranchId"); String role=(String)session.getAttribute("role"); boolean managerView="MANAGER".equals(role); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Danh sách nhân viên | CineFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/shell.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/forms.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/tables.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/common/badges.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager/staff.css"></head><body><div class="cf-manager-shell"><jsp:include page="/manager/sidebar.jsp"/><div class="cf-manager-main"><jsp:include page="/manager/topbar.jsp"/><main class="cf-content"><div class="cf-page-header"><div><p class="cf-breadcrumb">Nhân sự / Danh sách nhân viên</p><h1><%=managerView?"Nhân sự trung tâm":"Quản lý nhân viên"%></h1><p><%=managerView?"Quản lý tài khoản nhân viên tại trung tâm được phân công.":"Quản lý và phân công nhân viên trên toàn hệ thống."%></p></div></div>
<%if(!managerView){%><form class="cf-toolbar" method="get" action="${pageContext.request.contextPath}/staff"><div class="cf-field"><label>Trung tâm<select name="branchId"><option value="">Tất cả trung tâm</option><%for(Branch b:branches){%><option value="<%=b.getBranchId()%>" <%=selectedBranchId!=null&&selectedBranchId==b.getBranchId()?"selected":""%>><%=b.getBranchName()%></option><%}%></select></label></div><button class="cf-btn cf-btn-secondary" type="submit">Lọc danh sách</button></form><%}%>
<section class="cf-card"><div class="cf-card-header"><div><h2>Danh sách nhân viên</h2><p><%=staff==null?0:staff.size()%> tài khoản đang hiển thị.</p></div></div><div class="cf-card-body"><div class="cf-table-wrap"><table class="cf-table"><thead><tr><th>Nhân viên</th><th>Vai trò</th><th>Trung tâm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><%if(staff==null||staff.isEmpty()){%><tr><td colspan="5" class="cf-empty">Chưa có nhân viên phù hợp.</td></tr><%}else for(User item:staff){String st=item.getStatus();%><tr><td><strong><%=item.getFullName()%></strong><small class="staff-email"><%=item.getEmail()%></small></td><td><span class="cf-badge cf-badge-info"><%=item.getRole()%></span></td><td><%if(managerView&&branches!=null&&!branches.isEmpty()){%><%=branches.get(0).getBranchName()%><%}else{%><select class="staff-select" name="branchId" form="staff-<%=item.getUserId()%>"><option value="">Chưa phân công</option><%for(Branch b:branches){%><option value="<%=b.getBranchId()%>" <%=item.getBranchId()!=null&&item.getBranchId()==b.getBranchId()?"selected":""%>><%=b.getBranchName()%></option><%}%></select><%}%></td><td><span class="cf-badge <%= "ACTIVE".equals(st)?"cf-badge-success":"LOCKED".equals(st)?"cf-badge-danger":"cf-badge-warning"%>"><%= "ACTIVE".equals(st)?"Đang hoạt động":"LOCKED".equals(st)?"Đã khóa":"Tạm ngưng"%></span></td><td><form id="staff-<%=item.getUserId()%>" method="post" action="${pageContext.request.contextPath}/staff"><input type="hidden" name="userId" value="<%=item.getUserId()%>"><%if(managerView&&!branches.isEmpty()){%><input type="hidden" name="branchId" value="<%=branches.get(0).getBranchId()%>"><%}%><select name="status" class="staff-select"><option value="ACTIVE" <%= "ACTIVE".equals(st)?"selected":""%>>Kích hoạt</option><option value="INACTIVE" <%= "INACTIVE".equals(st)?"selected":""%>>Tạm ngưng</option><option value="LOCKED" <%= "LOCKED".equals(st)?"selected":""%>>Khóa</option></select><button class="cf-btn cf-btn-primary cf-btn-sm" type="submit">Lưu</button></form></td></tr><%}%></tbody></table></div></div></section></main></div></div></body></html>


